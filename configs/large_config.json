{
  "model": {
    "d_model": 512,
    "n_heads": 8,
    "num_encoder_layers": 6,
    "num_decoder_layers": 6,
    "d_ff": 2048,
    "max_len": 100,
    "dropout": 0.1,
    "share_embeddings": true
  },
  "training": {
    "num_epochs": 50,
    "batch_size": 64,
    "learning_rate": 1e-4,
    "warmup_steps": 8000,
    "clip_grad_norm": 1.0,
    "label_smoothing": 0.1,
    "log_interval": 50,
    "seed": 42
  },
  "data": {
    "dataset": "multi30k",
    "src_lang": "en",
    "tgt_lang": "de",
    "data_dir": "data/multi30k",
    "max_vocab_size": 50000
  }
}