{
  "model": {
    "d_model": 256,
    "n_heads": 8,
    "num_encoder_layers": 4,
    "num_decoder_layers": 4,
    "d_ff": 1024,
    "max_len": 100,
    "dropout": 0.1,
    "share_embeddings": false
  },
  "training": {
    "num_epochs": 30,
    "batch_size": 32,
    "learning_rate": 1e-4,
    "warmup_steps": 4000,
    "clip_grad_norm": 1.0,
    "label_smoothing": 0.0,
    "log_interval": 100,
    "seed": 42
  },
  "data": {
    "dataset": "multi30k",
    "src_lang": "en",
    "tgt_lang": "de",
    "data_dir": "data/multi30k",
    "max_vocab_size": 30000
  }
}